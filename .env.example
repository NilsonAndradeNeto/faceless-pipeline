# Copie para .env e preencha. NUNCA commite o .env.

# --- LLM ---
# https://console.groq.com/keys
GROQ_API_KEY=
# https://platform.openai.com/api-keys (fallback; precisa de crédito em /billing)
OPENAI_API_KEY=

# --- B-roll ---
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Voz ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Notificações (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube (OAuth "Desktop app" baixado do Google Cloud Console) ---
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json

# --- Instagram Graph API ---
META_APP_ID=
META_APP_SECRET=
IG_TOKEN_PT=
IG_TOKEN_ES=

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Infra local (gerados pelo install.ps1) ---
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
